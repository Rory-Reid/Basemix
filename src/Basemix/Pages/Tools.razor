@page "/tools"
@using Basemix.Db
@using System.IO
@using System.IO.Compression
@using Basemix.Lib
@using Basemix.Lib.Persistence
@using CommunityToolkit.Maui.Storage
@inject GetDataDirectory GetDataDirectory;
@inject GetDatabasePath GetDatabasePath;
@inject Migrator Migrator;
@inject MediaMigrator MediaMigrator;
@inject ErrorContext ErrorContext;
@inject NavigationManager Nav;
@implements IDisposable;

<h1>Tools</h1>

<p>
    Database location:
    <br />
    @dbPath
</p>

<button class="btn btn-primary" @onclick="ExportDb">Export database</button>


@if (!string.IsNullOrEmpty(ErrorContext.LastError))
{
    <hr />
    <h2>Last Application Error</h2>
    <p>@ErrorContext.LastError</p>
}

<button class="btn btn-primary" @onclick="@(() => Nav.NavigateTo("/import/ratrecords"))">Import from Rat Records spreadsheet</button>

<hr />

<h2>Danger zone</h2>

<p>
    The buttons and options in this section will perform irreversible changes to your data. Please make sure you've
    backed up your database, or at the very least have made peace with whatever will happen as a result of these actions.
</p>


<input type="checkbox" @bind="dangerZoneEnabled" id="dangerCheckbox"/>
<label for="dangerCheckbox">I know what I'm doing</label>
<br />
<br />

<div class="btn-toolbar" role="toolbar" aria-label="Dangerous Buttons">
    <div class="btn-group mr-2" role="group">
        <button class="btn btn-danger" @onclick="RecreateDatabase" disabled="@(!dangerZoneEnabled)">Delete and re-create database</button>
    </div>
    <div class="btn-group mr-2" role="group" aria-label="Second group">
        <button class="btn btn-primary" @onclick="LoadDb" disabled="@(!dangerZoneEnabled)">Load database from file</button>
    </div>
</div>
@if (this.dbModified)
{
    <p>
        The database has been modified, you shouldn't need to restart Basemix but if anything looks off, try restarting
        before editing any data.
    </p>
}

@code
{
    private CancellationTokenSource cts = new();
    
    private bool dangerZoneEnabled = false;
    private string dbPath = "ERROR";
    private string dbDir = "ERROR";
    private bool dbModified = false;

    protected override void OnInitialized()
    {
        this.dbPath = GetDatabasePath();
        this.dbDir = GetDataDirectory();
    }

    public void RecreateDatabase()
    {
        if (!File.Exists(dbPath) || !this.dangerZoneEnabled)
        {
            return;
        }

        var mediaDbPath = BasemixData.GetDbFilePath(BasemixData.MediaDbName);

        File.Delete(dbPath);
        if (File.Exists(mediaDbPath))
        {
            File.Delete(mediaDbPath);
        }

        this.Migrator.Start();
        this.MediaMigrator.Start();
        this.dbModified = true;
    }

    public async Task ExportDb()
    {
        try
        {
            var mediaDbPath = BasemixData.GetDbFilePath(BasemixData.MediaDbName);
            var tempZipPath = Path.Combine(FileSystem.Current.CacheDirectory, "basemix-backup.zip");

            if (File.Exists(tempZipPath))
            {
                File.Delete(tempZipPath);
            }

            await using (var zip = await ZipFile.OpenAsync(tempZipPath, ZipArchiveMode.Create))
            {
                await zip.CreateEntryFromFileAsync(dbPath, BasemixData.StandardDbName);
                if (File.Exists(mediaDbPath))
                {
                    await zip.CreateEntryFromFileAsync(mediaDbPath, BasemixData.MediaDbName);
                }
            }

            await using var file = new FileStream(tempZipPath, FileMode.Open);
#if ANDROID
            await Share.Default.RequestAsync(new ShareFileRequest
            {
                Title = "Save database backup",
                File = new ShareFile(tempZipPath)
            });
#else
            try
            {
                await FileSaver.Default.SaveAsync("basemix-backup.zip", file, cts.Token);
            }
            catch (FolderPickerException e) when (e.Message is "Operation cancelled.")
            {
            }
            catch (FileSaveException e) when (e.Message is "Path doesn't exist.")
            {
                // CommunityToolkit doesn't handle people "cancelling" the file dialog and instead throws this exception.
            }
            catch (IndexOutOfRangeException e) when (e.Message.Contains("Arg_IndexOutOfRangeException"))
            {
                // Potential bug in CommunityToolkit for android. Seems to be an issue with returning the filepath
                // and not with actually saving the file. I can safely ignore it for now.
            }
#endif
        }
        catch (Exception e)
        {
            this.ErrorContext.LastError = e.ToString();
        }
    }

    public async Task LoadDb()
    {
        var mediaDbPath = BasemixData.GetDbFilePath(BasemixData.MediaDbName);
        var backupDbPath = Path.Combine(dbDir, "backup.sqlite3");
        var backupMediaDbPath = Path.Combine(dbDir, "backup-media.sqlite3");
        try
        {
            var file = await FilePicker.PickAsync(new PickOptions
            {
                PickerTitle = "Select a backup file (basemix-backup.zip or basemix.sqlite3)",
                FileTypes = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
                {
                    { DevicePlatform.iOS, new[] {"public.data"}}, // Allow all files - iOS doesn't have predefined SQLite UTTypes
                    { DevicePlatform.Android, new[] {"application/vnd.sqlite3", "application/x-sqlite3", "application/octet-stream", "application/zip"}}, // MIME type
                    { DevicePlatform.WinUI, new[] {".sqlite3", ".sqlite", ".zip"}}, // file extension
                    { DevicePlatform.macOS, new[] {"sqlite3", "sqlite", "zip"}}, // UTType values
                    { DevicePlatform.MacCatalyst, new[] {"sqlite3", "sqlite3", "public.zip-archive"}}
                })
            });

            if (file == null)
            {
                return;
            }

            var isZip = await IsValidZipFile(file.FullPath);
            var isSqlite = !isZip && await IsValidSqliteFile(file.FullPath);

            if (!isZip && !isSqlite)
            {
                this.ErrorContext.LastError = "The selected file is not a valid backup. Please select a .zip backup or a .sqlite database file.";
                return;
            }

            // Back up existing databases
            if (File.Exists(backupDbPath))
            {
                File.Delete(backupDbPath);
            }
            
            if (File.Exists(backupMediaDbPath))
            {
                File.Delete(backupMediaDbPath);
            }
            
            File.Move(dbPath, backupDbPath);
            if (File.Exists(mediaDbPath))
            {
                File.Move(mediaDbPath, backupMediaDbPath);
            }

            if (isZip)
            {
                await using var zip = await ZipFile.OpenReadAsync(file.FullPath);
                var mainEntry = zip.GetEntry(BasemixData.StandardDbName);
                if (mainEntry == null)
                {
                    // Restore backups since the zip doesn't contain the expected database
                    File.Move(backupDbPath, dbPath);
                    if (File.Exists(backupMediaDbPath)) File.Move(backupMediaDbPath, mediaDbPath);
                    this.ErrorContext.LastError = $"The zip file does not contain '{BasemixData.StandardDbName}'. Please select a valid basemix backup.";
                    return;
                }

                await mainEntry.ExtractToFileAsync(dbPath);

                var mediaEntry = zip.GetEntry(BasemixData.MediaDbName);
                if (mediaEntry != null)
                {
                    await mediaEntry.ExtractToFileAsync(mediaDbPath);
                }
            }
            else
            {
                // Legacy single-file restore — only restores the main database
                await using var loadedFile = File.Open(file.FullPath, FileMode.Open);
                await using var import = File.Open(dbPath, FileMode.CreateNew);
                await loadedFile.CopyToAsync(import);
            }

            this.Migrator.Start();
            this.MediaMigrator.Start();
            this.dbModified = true;
        }
        catch (Exception e)
        {
            this.ErrorContext.LastError = $"Loading failed - you might need to manually fix this. Your old databases have been moved to {backupDbPath} and {backupMediaDbPath}, please make copies, then rename them to `db.sqlite` and `media.sqlite` to restore. Do not click load again, it will delete your backups. \nError Details Below:\n{e}";
        }
    }

    private static async Task<bool> IsValidZipFile(string filePath)
    {
        try
        {
            // ZIP files begin with the magic bytes PK (0x50, 0x4B)
            var buffer = new byte[4];
            await using var fileStream = File.OpenRead(filePath);
            var bytesRead = await fileStream.ReadAsync(buffer, 0, 4);
            if (bytesRead < 4)
            {
                return false;
            }
            return buffer[0] == 0x50 && buffer[1] == 0x4B && buffer[2] == 0x03 && buffer[3] == 0x04;
        }
        catch
        {
            return false;
        }
    }

    private static async Task<bool> IsValidSqliteFile(string filePath)
    {
        try
        {
            // SQLite files begin with the magic header "SQLite format 3\0"
            const string sqliteMagicHeader = "SQLite format 3";
            var buffer = new byte[16];
            
            await using var fileStream = File.OpenRead(filePath);
            var bytesRead = await fileStream.ReadAsync(buffer, 0, 16);
            
            if (bytesRead < 16)
                return false;
                
            var header = System.Text.Encoding.UTF8.GetString(buffer, 0, sqliteMagicHeader.Length);
            return header == sqliteMagicHeader;
        }
        catch
        {
            return false;
        }
    }

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }
}